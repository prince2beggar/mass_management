# ==============================================================================
# MessMate SaaS — Production Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=3000

# Base URL & Root Domain for Wildcard Subdomains
NEXT_PUBLIC_APP_URL="https://messmate.com"
NEXT_PUBLIC_ROOT_DOMAIN="messmate.com"

# Database Connection (PostgreSQL for Production / SQLite file for local stage)
# SQLite: "file:./dev.db"
# PostgreSQL: "postgresql://postgres:secure_password@db.messmate.com:5432/messmate?schema=public&sslmode=require"
DATABASE_URL="file:./dev.db"

# Session & Authentication Secret Key (Generate with: openssl rand -base64 32)
AUTH_SECRET="your-super-secret-random-32-byte-hex-key"

# Private Object Storage (AWS S3 / Cloudflare R2 / MinIO for receipt vouchers)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="messmate-documents"
STORAGE_ACCESS_KEY_ID="your_access_key"
STORAGE_SECRET_ACCESS_KEY="your_secret_key"
STORAGE_PUBLIC_DOMAIN="https://cdn.messmate.com"

# Payment Gateway Sandbox / Live Credentials
# bKash Merchant API
BKASH_APP_KEY="your_bkash_app_key"
BKASH_APP_SECRET="your_bkash_app_secret"
BKASH_USERNAME="your_bkash_username"
BKASH_PASSWORD="your_bkash_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Nagad Merchant API
NAGAD_MERCHANT_ID="your_nagad_merchant_id"
NAGAD_PUBLIC_KEY="your_nagad_public_key"
NAGAD_PRIVATE_KEY="your_nagad_private_key"

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID="your_store_id"
SSLCOMMERZ_STORE_PASS="your_store_pass"
SSLCOMMERZ_IS_SANDBOX=true

# Redis Cache & Background Jobs (Optional for high volume workloads)
REDIS_URL="redis://default:secure_password@redis.messmate.com:6379"

# Security & Isolation Flags
NEXT_TELEMETRY_DISABLED=1
PRISMA_ENGINES_CACHE_DIR="D:\mass_management\.cache\prisma"
