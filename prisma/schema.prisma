generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Tenant {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  description       String?
  address           String?
  phone             String?
  email             String?
  messType          String              @default("STUDENT") // STUDENT, BACHELOR, JOB_HOLDER, SHARED_APARTMENT
  mealSystem        String              @default("FLEXIBLE") // FIXED, FLEXIBLE
  currency          String              @default("BDT")
  primaryColor      String              @default("#4f46e5")
  secondaryColor    String              @default("#06b6d4")
  customDomain      String?             @unique
  isVerified        Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  memberships       Membership[]
  rooms             Room[]
  mealConfig        MealConfiguration?
  mealEntries       MealEntry[]
  bazarEntries      BazarEntry[]
  invoices          Invoice[]
  payments          Payment[]
  ledgerEntries     LedgerEntry[]
  monthlyClosings   MonthlyClosing[]
  emergencyContacts EmergencyContact[]
  notices           Notice[]
  complaints        Complaint[]
  rentalListings    RentalListing[]
  auditLogs         AuditLog[]
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  phone           String?
  name            String
  passwordHash    String
  avatarUrl       String?
  nidNumber       String?
  isSuperAdmin    Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships     Membership[]
}

model Membership {
  id            String              @id @default(cuid())
  userId        String
  tenantId      String
  role          String              @default("MEMBER") // OWNER, ADMIN, MODERATOR, ACCOUNTANT, MEAL_MANAGER, MEMBER, GUEST
  status        String              @default("ACTIVE") // ACTIVE, PENDING, INACTIVE
  joinedAt      DateTime            @default(now())

  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  allocations   MemberAllocation[]
  mealEntries   MealEntry[]
  bazarEntries  BazarEntry[]
  invoices      Invoice[]
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  complaints    Complaint[]

  @@unique([userId, tenantId])
}

model Room {
  id                  String             @id @default(cuid())
  tenantId            String
  roomNumber          String
  floor               Int                @default(1)
  roomType            String             @default("SHARED") // SINGLE, SHARED, MASTER
  capacity            Int                @default(2)
  baseRent            Float              @default(0)
  facilities          String             @default("[]") // JSON string array
  isRentableShortTerm Boolean            @default(false)
  shortTermDailyRate  Float              @default(0)

  tenant              Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beds                Bed[]

  @@unique([tenantId, roomNumber])
}

model Bed {
  id           String              @id @default(cuid())
  roomId       String
  bedNumber    String
  status       String              @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED
  monthlyRent  Float               @default(0)

  room         Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  allocations  MemberAllocation[]

  @@unique([roomId, bedNumber])
}

model MemberAllocation {
  id           String      @id @default(cuid())
  membershipId String
  bedId        String
  startDate    DateTime    @default(now())
  endDate      DateTime?
  status       String      @default("ACTIVE") // ACTIVE, VACATED

  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  bed          Bed         @relation(fields: [bedId], references: [id], onDelete: Cascade)
}

model MealConfiguration {
  id                  String   @id @default(cuid())
  tenantId            String   @unique
  breakfastEnabled    Boolean  @default(true)
  lunchEnabled        Boolean  @default(true)
  dinnerEnabled       Boolean  @default(true)
  cutoffBreakfastHour Int      @default(22) // 10 PM day before
  cutoffLunchHour     Int      @default(8)  // 8 AM same day
  cutoffDinnerHour    Int      @default(16) // 4 PM same day
  fixedBreakfastCost  Float    @default(30)
  fixedLunchCost      Float    @default(60)
  fixedDinnerCost     Float    @default(60)
  guestMealRate       Float    @default(80)

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model MealEntry {
  id             String      @id @default(cuid())
  tenantId       String
  membershipId   String
  date           String      // YYYY-MM-DD
  breakfast      Float       @default(0)
  lunch          Float       @default(1)
  dinner         Float       @default(1)
  guestBreakfast Float       @default(0)
  guestLunch     Float       @default(0)
  guestDinner    Float       @default(0)
  isOff          Boolean     @default(false)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership     Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([tenantId, membershipId, date])
}

model BazarEntry {
  id                  String       @id @default(cuid())
  tenantId            String
  shopperMembershipId String
  date                String       // YYYY-MM-DD
  totalAmount         Float
  category            String       @default("GROCERY") // VEGETABLE, MEAT_FISH, GROCERY, SPICE, OIL, GAS, OTHER
  receiptUrl          String?
  notes               String?
  isVerified          Boolean      @default(false)
  verifiedBy          String?
  createdAt           DateTime     @default(now())

  tenant              Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  shopper             Membership   @relation(fields: [shopperMembershipId], references: [id], onDelete: Cascade)
  items               BazarItem[]
}

model BazarItem {
  id           String      @id @default(cuid())
  bazarEntryId String
  itemName     String
  quantity     Float       @default(1)
  unit         String      @default("kg")
  unitPrice    Float       @default(0)
  totalPrice   Float       @default(0)

  bazarEntry   BazarEntry  @relation(fields: [bazarEntryId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String
  membershipId  String
  monthYear     String        // e.g. "2026-11"
  invoiceNumber String        @unique
  totalAmount   Float
  paidAmount    Float         @default(0)
  status        String        @default("PENDING") // PENDING, PARTIAL, PAID, OVERDUE
  dueDate       DateTime
  createdAt     DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership    Membership    @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  items         InvoiceItem[]
  payments      Payment[]
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  category    String   // RENT, MEAL, ELECTRICITY, GAS, WATER, WIFI, MAID, TRASH, OTHER
  amount      Float

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id           String      @id @default(cuid())
  tenantId     String
  membershipId String
  invoiceId    String?
  amount       Float
  method       String      // CASH, BKASH, NAGAD, ROCKET, BANK
  trxId        String?
  receiptUrl   String?
  status       String      @default("PENDING") // PENDING, APPROVED, REJECTED
  paidAt       DateTime    @default(now())
  verifiedAt   DateTime?
  verifiedBy   String?

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
}

model LedgerEntry {
  id           String      @id @default(cuid())
  tenantId     String
  membershipId String
  type         String      // DEBIT, CREDIT
  category     String      // MEAL_EXPENSE, RENT_CHARGE, UTILITY_CHARGE, PAYMENT_RECEIVED, ADJUSTMENT
  amount       Float
  balanceAfter Float
  description  String
  date         DateTime    @default(now())

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membership   Membership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model MonthlyClosing {
  id                  String   @id @default(cuid())
  tenantId            String
  monthYear           String   // e.g. "2026-11"
  totalBazarExpense   Float
  totalMealsConsumed  Float
  calculatedMealRate  Float
  totalUtilityCost    Float
  totalRentCollected  Float
  closedAt            DateTime @default(now())
  closedBy            String
  notes               String?

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, monthYear])
}

model EmergencyContact {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  serviceType String   // POLICE, FIRE_SERVICE, AMBULANCE, DOCTOR, PHARMACY, POLICE_STATION, LANDLORD, ELECTRICIAN, PLUMBER
  phone       String
  address     String?
  isNational  Boolean  @default(false)

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Notice {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  content     String
  priority    String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Complaint {
  id           String     @id @default(cuid())
  tenantId     String
  submittedBy  String
  title        String
  description  String
  category     String     @default("GENERAL") // ROOM, MEAL, CLEANLINESS, NOISE, FINANCIAL, OTHER
  status       String     @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED
  createdAt    DateTime   @default(now())
  resolvedAt   DateTime?

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member       Membership @relation(fields: [submittedBy], references: [id], onDelete: Cascade)
}

model RentalListing {
  id            String    @id @default(cuid())
  tenantId      String
  title         String
  description   String
  roomType      String    // SINGLE, SHARED
  rentMonthly   Float
  rentDaily     Float?
  availableFrom DateTime  @default(now())
  isAvailable   Boolean   @default(true)
  images        String    @default("[]") // JSON string array
  amenities     String    @default("[]") // JSON string array

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  actorId    String?
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}
